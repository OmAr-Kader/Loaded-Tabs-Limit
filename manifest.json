{
  "manifest_version": 3,
  "name": "Sturdy: Browser Cleaner",
  "version": "1.1.2",
  "description": "Keeps the N most recently used tabs loaded and discards the rest, with a delay and a site filter list and automatic cache clearing.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "storage", "alarms", "browsingData"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
  },
  "action": {
    "default_title": "Sturdy: Browser Cleaner – Settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
