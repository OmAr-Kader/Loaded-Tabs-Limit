{
  "manifest_version": 3,
  "name": "Loaded Tabs Limit",
  "version": "1.0.0",
  "description": "Keeps the N most recently used tabs loaded and discards the rest, with a delay and a site filter list.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
  },
  "action": {
    "default_title": "Loaded Tabs Limit – Settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
